extends layout

block content
  .container-fluid
    h1.text-center Blockchain Explorer (Interactive)

    p.text-center.text-muted
      | Edit any "Previous Hash" to simulate tampering. Changes propagate through the chain.

    .text-center
      button.btn.btn-success#refreshBtn Reset Chain
      button.btn.btn-warning#forkBtn(style="margin-left:10px") Simulate Fork

    hr

    .row#blockContainer

    hr
    h3.text-center Fork Simulation

    .row
      .col-md-6
        h4.text-center Chain A
        #chainA

      .col-md-6
        h4.text-center Chain B (Longest Chain)
        #chainB

  script.
    (function () {

      let blockchainData = [];

      // ==============================
      // LOAD BLOCKCHAIN
      // ==============================
      function loadBlockchain() {
        fetch('/api/chain')
          .then(res => res.json())
          .then(data => {

            blockchainData = data;

            const container = document.getElementById('blockContainer');
            container.innerHTML = '';

            data.forEach((block, i) => {

              const blockHtml = `
                <div class="col-md-3">
                  <div class="panel panel-default block-card" id="block-${i}">
                    <div class="panel-heading text-center">
                      <strong>Block ${block.index}</strong>
                    </div>
                    <div class="panel-body">

                      <label>Hash</label>
                      <input class="form-control" id="hash-${i}" value="${block.hash}" readonly>

                      <label>Previous Hash</label>
                      <input class="form-control editable" id="prev-${i}" value="${block.previousHash}" title="Changing this breaks the chain">

                      <label>Merkle Root</label>
                      <input class="form-control editable" id="merkle-${i}" value="${block.merkleRoot}">

                      <label>Nonce</label>
                      <input class="form-control editable" id="nonce-${i}" value="0">

                      <br>
                      <strong id="status-${i}"></strong>

                    </div>
                  </div>
                </div>
              `;

              container.innerHTML += blockHtml;
            });

            // attach listeners
            document.querySelectorAll('.editable').forEach(input => {
              input.addEventListener('input', validateLiveChain);
            });

            // disable genesis prev
            if (document.getElementById('prev-0')) {
              document.getElementById('prev-0').disabled = true;
            }

            validateLiveChain();
          })
          .catch(err => console.error("Error loading blockchain:", err));
      }

      // ==============================
      // LIVE VALIDATION
      // ==============================
      function validateLiveChain() {

        let broken = false;

        for (let i = 0; i < blockchainData.length; i++) {

          const blockEl = document.getElementById(`block-${i}`);
          const statusEl = document.getElementById(`status-${i}`);

          if (!blockEl || !statusEl) continue;

          blockEl.classList.remove('panel-success', 'panel-danger');

          if (i === 0) {
            statusEl.innerText = "GENESIS";
            statusEl.style.color = "blue";
            blockEl.classList.add('panel-success');
            continue;
          }

          const prevInput = document.getElementById(`prev-${i}`).value;
          const prevHash = document.getElementById(`hash-${i-1}`).value;

          if (prevInput !== prevHash || broken) {

            if (!broken) {
              statusEl.innerText = "❌ FIRST BROKEN";
            } else {
              statusEl.innerText = "BROKEN";
            }

            broken = true;

            setTimeout(() => {
              blockEl.classList.add('panel-danger');
            }, i * 150);

            statusEl.style.color = "red";

          } else {
            blockEl.classList.add('panel-success');
            statusEl.innerText = "VALID";
            statusEl.style.color = "green";
          }
        }
      }

      // ==============================
      // FORK SIMULATION
      // ==============================
      function simulateFork() {

        if (!blockchainData.length) return;

        const chainA = blockchainData.slice(0, 3);
        const chainB = blockchainData.slice(0, 4); // longer chain

        function renderChain(chain, containerId) {
          let html = '';

          chain.forEach(block => {
            html += `
              <div class="panel panel-default">
                <div class="panel-heading">
                  Block ${block.index}
                </div>
                <div class="panel-body">
                  <small>${block.hash.substring(0, 20)}...</small>
                </div>
              </div>
            `;
          });

          const el = document.getElementById(containerId);
          if (el) el.innerHTML = html;
        }

        renderChain(chainA, 'chainA');
        renderChain(chainB, 'chainB');
      }

      // ==============================
      // INIT
      // ==============================
      document.addEventListener("DOMContentLoaded", () => {

        loadBlockchain();

        document.getElementById('refreshBtn').addEventListener('click', () => {
          loadBlockchain();
          document.getElementById('chainA').innerHTML = '';
          document.getElementById('chainB').innerHTML = '';
        });

        document.getElementById('forkBtn').addEventListener('click', simulateFork);

      });

    })();